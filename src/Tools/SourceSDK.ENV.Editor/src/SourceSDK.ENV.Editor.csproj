<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET 10, x86/x64, bin\<platform>\<configuration> (shared with the launcher) -->
  <Import Project="..\..\..\Common.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>SourceSDK.ENV.Editor.Program</StartupObject>
    <ApplicationIcon>crowbar.ico</ApplicationIcon>
    <SignAssembly>False</SignAssembly>
    <Version>1.1.0</Version>
    <Product>SourceSDK.ENV.Editor</Product>
    <Copyright>EpicMorg</Copyright>
    <PackageProjectUrl>https://github.com/EpicMorg/UniversalValveToolbox</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EpicMorg/UniversalValveToolbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="crowbar.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- DarkUI.Net5 was removed from nuget.org; DarkUI.CE is a maintained fork of the same DarkUI (net10.0-windows) -->
    <PackageReference Include="DarkUI.CE" Version="3.2.1" />
    <PackageReference Include="Octokit" Version="0.50.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>

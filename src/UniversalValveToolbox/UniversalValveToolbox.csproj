<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET 10, x86/x64, bin\<platform>\<configuration> (shared with the bundled tools) -->
  <Import Project="..\Common.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UniversalValveToolbox</RootNamespace>
    <AssemblyName>UniversalValveToolbox</AssemblyName>
    <ApplicationIcon>toolbox.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>2.0.0</Version>
    <AssemblyTitle>Universal Valve Toolbox</AssemblyTitle>
    <Description>Universal Valve Toolbox</Description>
    <Product>Universal Valve Toolbox</Product>
    <Copyright>Copyright © EpicMorg</Copyright>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyTrademarkAttribute">
      <_Parameter1>Valve</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>de66895f-7317-45d3-b5ca-292253ce086a</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!--
    Bundled tools: built before the launcher (same configuration/platform) and copied into
    <output>\tools\<Name>\, so the launcher finds them when run from VS and the output folder is the bundle.
    Their addon entries (json\addons, category catBundled) point to tools\<Name>\<exe>.
  -->
  <ItemGroup>
    <BundledTool Include="SourceSDK.ENV.Editor" ProjectPath="..\Tools\SourceSDK.ENV.Editor\src\SourceSDK.ENV.Editor.csproj" />
    <BundledTool Include="RetimePhonemeUtil" ProjectPath="..\Tools\RetimePhonemeUtil\src\kru.gui\kru.gui.csproj" />
    <ProjectReference Include="@(BundledTool->'%(ProjectPath)')" ReferenceOutputAssembly="false" Private="false"
                      SetPlatform="Platform=$(Platform)" SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <Target Name="CopyBundledTools" AfterTargets="Build" Outputs="%(BundledTool.Identity)">
    <PropertyGroup>
      <_BundledName>%(BundledTool.Identity)</_BundledName>
      <_BundledDir>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\%(BundledTool.ProjectPath)'))))\bin\$(Platform)\$(Configuration)\</_BundledDir>
    </PropertyGroup>
    <ItemGroup>
      <_BundledFile Remove="@(_BundledFile)" />
      <_BundledFile Include="$(_BundledDir)**\*" Exclude="$(_BundledDir)**\*.pdb" />
    </ItemGroup>
    <Error Condition="'@(_BundledFile)' == ''" Text="Bundled tool $(_BundledName) has no build output in $(_BundledDir)" />
    <Copy SourceFiles="@(_BundledFile)" DestinationFiles="@(_BundledFile->'$(OutDir)tools\$(_BundledName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Native Steam API from the Steamworks SDK (redistributable), used through Steam\SteamNative.cs; one per platform -->
  <ItemGroup>
    <None Remove="Native\**" />
    <None Include="Native\steam_api.dll" Condition="'$(Platform)' == 'x86'" Link="steam_api.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\steam_api64.dll" Condition="'$(Platform)' == 'x64'" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Strongly typed resources (translations + Resources.resx) and settings -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\translations\*.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>%(Filename).Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Unused owner-drawn combo box, never was in the build -->
  <ItemGroup>
    <Compile Remove="UI\View\**" />
  </ItemGroup>

  <!-- Catalogs next to the exe (settings.json, projects and addon templates are created/edited by the user, not shipped) -->
  <ItemGroup>
    <None Update="json\engines\*.json;json\addons\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

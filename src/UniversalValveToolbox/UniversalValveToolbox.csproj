<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UniversalValveToolbox</RootNamespace>
    <AssemblyName>UniversalValveToolbox</AssemblyName>
    <ApplicationIcon>toolbox.ico</ApplicationIcon>
    <!-- two builds: x86 and x64 (Any CPU from tools that do not pass a platform -> x64) -->
    <Platforms>x86;x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- output: bin/x64/Debug, bin/x86/Release, ... (no net10.0-windows or RID subfolders) -->
    <BaseOutputPath>bin\</BaseOutputPath>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>2.0.0</Version>
    <AssemblyTitle>Universal Valve Toolbox</AssemblyTitle>
    <Description>Universal Valve Toolbox</Description>
    <Product>Universal Valve Toolbox</Product>
    <Company>EpicMorg</Company>
    <Copyright>Copyright © EpicMorg</Copyright>
    <Deterministic>true</Deterministic>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyTrademarkAttribute">
      <_Parameter1>Valve</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>de66895f-7317-45d3-b5ca-292253ce086a</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Framework-only package (net40-net47); plain managed WinForms binding code that loads on .NET 10. TODO: replace with own binding helper -->
    <PackageReference Include="kasthack.binding.wf" Version="1.2.26" NoWarn="NU1701" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Native Steam API from the Steamworks SDK (redistributable), used through Steam\SteamNative.cs; one per platform -->
  <ItemGroup>
    <None Remove="Native\**" />
    <None Include="Native\steam_api.dll" Condition="'$(Platform)' == 'x86'" Link="steam_api.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\steam_api64.dll" Condition="'$(Platform)' == 'x64'" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Strongly typed resources (translations + Resources.resx) and settings -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\translations\*.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>%(Filename).Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Unused owner-drawn combo box, never was in the build -->
  <ItemGroup>
    <Compile Remove="UI\View\**" />
  </ItemGroup>

  <!-- Catalogs next to the exe (settings.json, projects and addon templates are created/edited by the user, not shipped) -->
  <ItemGroup>
    <None Update="json\engines\*.json;json\addons\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
